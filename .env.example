# Local development only. Replace values in .env.local; never commit it.
POSTGRES_DB=cumulore
POSTGRES_USER=cumulore
POSTGRES_PASSWORD=cumulore_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cumulore:cumulore_local_only@localhost:5432/cumulore
IDENTITY_PROVIDER=fake
MINIO_ROOT_USER=cumulore
MINIO_ROOT_PASSWORD=cumulore_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cumulore-local

# Cumulore Quest is credential-free by default. Leave these defaults in place
# for local demo use and CI. Only set OPENAI_API_KEY in ignored .env.local or
# deployment secrets after the Build Week live-release checklist is complete.
QUEST_PROVIDER=fixture
QUEST_LIVE_GENERATION_ENABLED=false
# OPENAI_API_KEY=
OPENAI_QUEST_MODEL=gpt-5.6-sol
OPENAI_QUEST_TIMEOUT_MS=45000
QUEST_SOURCE_MAX_CHARS=20000
